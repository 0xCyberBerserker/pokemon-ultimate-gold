  "method": {
    "scope": "Read-only comparison of exact retail and Alpha2 ROM data plus local decomp source. No emulator, save, or modified ROM was used.",
    "event_data": "Reused the existing exact-ROM HM event extractor and its NDS/BLZ/NARC reader. Resolved map tokens from each ROM's mapname.bin, read MapHeader scriptsBank/eventsBank fields, then compared selected raw ObjectEvent records.",
    "script_data": "Used the existing ndspy-backed HGSS script disassembler and pinned scrcmd.json to decode the relevant bytecode. Selected raw code ranges were compared between ROMs.",
    "personal_data": "Used ndspy.rom and ndspy.narc through the retail helper's named FNT path a/0/0/2 (file ID 131 in both ROMs). Read item1/item2 as little-endian u16 at offsets 0x0C/0x0E, matching the local retail BASE_STATS structure.",
    "runtime_tested": false
